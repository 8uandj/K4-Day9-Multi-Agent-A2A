# Secrets only. Model NAMES live in src/ec_dispute/config.py (README section 9).
# Copy to .env - .env must never be committed.

# OpenRouter (recommended: one key can route Qwen + Llama)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# If paid models return 402 insufficient credits, LLMClient retries once with openrouter/free.
# Free tier is low-rate-limit and should be used for smoke tests, not final runs.

# Groq fallback for Llama verifier
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
